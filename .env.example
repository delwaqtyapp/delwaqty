# =============================================================
# Delwaqty Platform - Environment Configuration
# =============================================================
# Copy this file to .env.dev, .env.staging, or .env.prod
# NEVER commit files with real credentials to version control.
#
# Usage:
#   flutter run --dart-define-from-file=.env.dev
#   flutter run --dart-define-from-file=.env.staging
#   flutter build apk --dart-define-from-file=.env.prod
# =============================================================

# --- Application ------------------------------------------------
APP_ENV=development          # development | staging | production

# --- Supabase ---------------------------------------------------
# Get these from: https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# ⚠ NEVER include SUPABASE_SERVICE_ROLE_KEY in client .env files.

# --- Firebase ---------------------------------------------------
# Get from: https://console.firebase.google.com
# Download google-services.json (Android) / GoogleService-Info.plist (iOS)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_APP_ID=1:xxx:android:xxx
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# --- Google Maps ------------------------------------------------
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable: Maps SDK, Directions API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Cloudflare (public values only) ----------------------------
# Get from: https://dash.cloudflare.com -> Overview
# ⚠ NEVER include R2_SECRET_KEY or R2_ACCESS_KEY in client .env files.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_BUCKET=delwaqty-assets
CLOUDFLARE_CDN_DOMAIN=cdn.delwaqty.com
