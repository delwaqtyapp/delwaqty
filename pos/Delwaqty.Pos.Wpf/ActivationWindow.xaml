<Window x:Class="Delwaqty.Pos.Wpf.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دلوقتي كاشير - التفعيل" Height="560" Width="520"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" FontSize="16">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1565C0" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="دلوقتي كاشير" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="تفعيل الجهاز لأول مرة" Foreground="#BBDEFB" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="حساب التاجر على منصة دلوقتي (البريد):" Margin="0,4"/>
        <TextBox Grid.Row="2" x:Name="EmailBox" Padding="8" FlowDirection="LeftToRight" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Text="كلمة المرور:" Margin="0,4"/>
        <PasswordBox Grid.Row="4" x:Name="PasswordBox" Padding="8" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5" Text="مفتاح الترخيص (12 رقماً، مثال 1234-5678-9012):" Margin="0,4"/>
        <TextBox Grid.Row="6" x:Name="KeyBox" Padding="8" FlowDirection="LeftToRight" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="7">
            <Button x:Name="ActivateButton" Content="تفعيل" FontSize="20" Padding="16,10"
                    Background="#2E7D32" Foreground="White" Click="Activate_Click"/>
            <TextBlock x:Name="ErrorText" Foreground="#B71C1C" TextWrapping="Wrap" Margin="0,10,0,0" TextAlignment="Center"/>
            <TextBlock Foreground="#777" TextWrapping="Wrap" Margin="0,12,0,0" TextAlignment="Center"
                       Text="التفعيل يحتاج إنترنت لأول مرة فقط. بعدها يعمل البرنامج بدون اتصال داخل فترة السماح."/>
        </StackPanel>
    </Grid>
</Window>
