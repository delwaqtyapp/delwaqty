<Window x:Class="Delwaqty.Pos.Wpf.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="توريد تشغيلة" Height="420" Width="440" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" FontSize="16">
    <StackPanel Margin="16">
        <TextBlock x:Name="ItemText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="الكمية الواردة:"/>
        <TextBox x:Name="QtyBox" Padding="8" Margin="0,2,0,8"/>
        <TextBlock Text="تاريخ الصلاحية (مثال 2027-05):"/>
        <TextBox x:Name="ExpiryBox" Padding="8" Margin="0,2,0,8" FlowDirection="LeftToRight"/>
        <TextBlock Text="رقم التشغيلة (اختياري):"/>
        <TextBox x:Name="BatchNoBox" Padding="8" Margin="0,2,0,8" FlowDirection="LeftToRight"/>
        <TextBlock Text="الصلاحية تُتابع محلياً على هذا الجهاز. رصيد المخزون الكلي يُحدَّث على الخادم عند الاتصال."
                   Foreground="#777" TextWrapping="Wrap" Margin="0,4"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="إلغاء" Padding="16,8" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button Content="تسجيل التوريد" Padding="16,8" Background="#2E7D32" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
