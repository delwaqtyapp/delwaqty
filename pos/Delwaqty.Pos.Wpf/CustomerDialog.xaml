<Window x:Class="Delwaqty.Pos.Wpf.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار عميل" Height="560" Width="560" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" FontSize="16">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="FilterBox" Padding="8" TextChanged="Filter_Changed" ToolTip="ابحث بالاسم أو الموبايل"/>
        <DataGrid Grid.Row="1" x:Name="CustomersGrid" Margin="0,8" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Pick_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Width="2*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="الموبايل" Width="*" Binding="{Binding Phone}"/>
                <DataGridTextColumn Header="الرصيد (دين)" Width="*" Binding="{Binding Balance}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10" Margin="0,4">
            <StackPanel>
                <TextBlock Text="عميل جديد:" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="NewNameBox" Width="180" Padding="6" ToolTip="الاسم"/>
                    <TextBox x:Name="NewPhoneBox" Width="140" Padding="6" Margin="8,0" ToolTip="الموبايل"/>
                    <Button Content="حفظ واختيار" Padding="12,6" Click="Create_Click" Background="#1565C0" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="إلغاء" Padding="16,8" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button Content="اختيار" Padding="16,8" Background="#2E7D32" Foreground="White" Click="Pick_Click"/>
        </StackPanel>
    </Grid>
</Window>
