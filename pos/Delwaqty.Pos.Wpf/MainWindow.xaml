<Window x:Class="Delwaqty.Pos.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دلوقتي كاشير" Height="780" Width="1280"
        FlowDirection="RightToLeft" WindowState="Maximized" FontSize="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#1565C0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TitleText" Text="دلوقتي كاشير" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="StoreText" Foreground="#BBDEFB" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="LicenseBadge" Foreground="#FFE082" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="SyncBadge" Text="غير متصل" Foreground="#FFAB91" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <!-- ============ SELL ============ -->
            <TabItem Header="بيع">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox x:Name="SearchBox" FontSize="20" Padding="8"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                        <TextBlock x:Name="SearchHint" Foreground="#777" Margin="4,2"/>
                        <DataGrid x:Name="SearchResults" AutoGenerateColumns="False" IsReadOnly="True"
                                  Height="430" SelectionMode="Single" MouseDoubleClick="AddSelected_Click">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Width="2*" Binding="{Binding DisplayName}"/>
                                <DataGridTextColumn Header="السعر" Width="*" Binding="{Binding DisplayPrice}"/>
                                <DataGridTextColumn Header="الرصيد" Width="*" Binding="{Binding DisplayStock}"/>
                                <DataGridTextColumn Header="الباركود" Width="*" Binding="{Binding Barcode}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8">
                            <Button Content="إضافة للفاتورة ➕" FontSize="17" Padding="12,8" Margin="4"
                                    Click="AddSelected_Click" Background="#2E7D32" Foreground="White"/>
                            <Button Content="صنف سريع (بدون تسجيل)" FontSize="17" Padding="12,8" Margin="4"
                                    Click="QuickLine_Click" Background="#455A64" Foreground="White"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="330">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الصنف" Width="2*" Binding="{Binding Name}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="الكمية" Width="*" Binding="{Binding Qty}"/>
                                <DataGridTextColumn Header="السعر" Width="*" Binding="{Binding UnitPrice}"/>
                                <DataGridTextColumn Header="الإجمالي" Width="*" Binding="{Binding Total}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6">
                            <Button Content="➖" Padding="10,4" Margin="2" Click="DecQty_Click"/>
                            <Button Content="➕" Padding="10,4" Margin="2" Click="IncQty_Click"/>
                            <Button Content="حذف السطر" Padding="10,4" Margin="2" Click="RemoveLine_Click" Background="#B71C1C" Foreground="White"/>
                        </WrapPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Text="الإجمالي:" FontSize="24" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#1565C0" Margin="8,0"/>
                            <TextBlock Text="خصم:" Margin="24,0,4,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="DiscountBox" Text="0" Width="80" TextChanged="Discount_Changed"/>
                        </DockPanel>
                        <WrapPanel Margin="0,6">
                            <Button Content="الدفع وإتمام البيع 💵" FontSize="19" Padding="18,12" Margin="4"
                                    Click="Pay_Click" Background="#00695C" Foreground="White"/>
                            <Button Content="إلغاء الفاتورة" FontSize="17" Padding="14,10" Margin="4"
                                    Click="ClearCart_Click" Background="#B71C1C" Foreground="White"/>
                        </WrapPanel>
                        <TextBlock x:Name="CartNote" Foreground="#E65100" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ STOCK ============ -->
            <TabItem Header="المخزون">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="عدّ صنفاً: ابحث، أدخل الكمية الفعلية، وسجّل." TextWrapping="Wrap"/>
                        <TextBox x:Name="StockSearchBox" FontSize="18" Padding="6" Margin="0,8" TextChanged="StockSearch_TextChanged"/>
                        <DataGrid x:Name="StockResults" AutoGenerateColumns="False" IsReadOnly="True" Height="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Width="2*" Binding="{Binding DisplayName}"/>
                                <DataGridTextColumn Header="السعر" Width="*" Binding="{Binding DisplayPrice}"/>
                                <DataGridTextColumn Header="الرصيد" Width="*" Binding="{Binding DisplayStock}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="الكمية الفعلية:" VerticalAlignment="Center"/>
                            <TextBox x:Name="CountedBox" Width="100" FontSize="18" Margin="8,0"/>
                            <Button Content="تسجيل الجرد" Padding="14,8" Click="RecordCount_Click" Background="#1565C0" Foreground="White"/>
                        </StackPanel>
                        <Button x:Name="AddProductButton" Content="إضافة صنف جديد ➕" Padding="14,8" Margin="0,8"
                                Click="AddProduct_Click" Background="#2E7D32" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="تغيير السعر" Padding="14,8" Click="PriceChange_Click" Background="#37474F" Foreground="White"/>
                            <Button Content="زيادة أسعار %" Padding="14,8" Margin="8,0,0,0" Click="BulkPrice_Click" Background="#37474F" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ CUSTOMERS & DEBTS ============ -->
            <TabItem Header="العملاء والديون">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="العملاء (الرصيد = إجمالي الدين المتبقي):" FontWeight="Bold"/>
                        <DataGrid x:Name="CustomersGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="440" Margin="0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Width="2*" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="الموبايل" Width="*" Binding="{Binding Phone}"/>
                                <DataGridTextColumn Header="الدين" Width="*" Binding="{Binding Balance}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="عميل جديد:" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBox x:Name="CustomerNameBox" Width="160" Padding="6"/>
                            <TextBox x:Name="CustomerPhoneBox" Width="130" Padding="6" Margin="8,0"/>
                            <Button Content="حفظ" Padding="14,6" Click="SaveCustomer_Click" Background="#2E7D32" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="تحصيل دفعة من العميل المحدد:" FontWeight="Bold" Margin="0,12,0,4"/>
                        <Button Content="تسجيل دفعة 💰" Padding="14,8" HorizontalAlignment="Left"
                                Click="DebtPayment_Click" Background="#00695C" Foreground="White"/>
                        <TextBlock Text="الأرصدة تتحدث من الخادم عند المزامنة." Foreground="#777" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ SHIFTS ============ -->
            <TabItem Header="الورديات والمبيعات">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Width="380">
                        <TextBlock x:Name="ShiftStateText" FontWeight="Bold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="عهدة البداية:" VerticalAlignment="Center"/>
                            <TextBox x:Name="FloatBox" Width="100" Padding="6" Margin="8,0" Text="0"/>
                            <Button Content="فتح وردية" Padding="14,8" Click="OpenShift_Click" Background="#2E7D32" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="النقدية المتوقعة في الدرج:" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ExpectedCashText" Text="-" FontSize="26" Foreground="#1565C0" Margin="0,4"/>
                        <TextBlock Text="النقدية الفعلية (العد اليدوي):"/>
                        <TextBox x:Name="ClosingCashBox" FontSize="18" Padding="6" Margin="0,4"/>
                        <Button Content="تقفيل الوردية" FontSize="17" Padding="14,8" Margin="0,8"
                                Click="CloseShift_Click" Background="#00695C" Foreground="White"/>
                        <TextBlock x:Name="CloseResultText" TextWrapping="Wrap" Foreground="#2E7D32"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="مبيعات الوردية (اختر فاتورة لإلغائها):" FontWeight="Bold"/>
                        <DataGrid x:Name="ShiftSalesGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="420" Margin="0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المرجع" Width="*" Binding="{Binding ShortId}"/>
                                <DataGridTextColumn Header="الإجمالي" Width="*" Binding="{Binding Total}"/>
                                <DataGridTextColumn Header="العميل" Width="*" Binding="{Binding CustomerName}"/>
                                <DataGridTextColumn Header="الحالة" Width="*" Binding="{Binding StatusAr}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="إلغاء الفاتورة المحددة (مرتجع)" Padding="14,8" HorizontalAlignment="Left"
                                Click="VoidSale_Click" Background="#B71C1C" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ SYNC / SETTINGS ============ -->
            <TabItem Header="المزامنة والإعدادات">
                <StackPanel Margin="12" Width="520">
                    <Button Content="مزامنة الآن 🔄" FontSize="17" Padding="14,10" HorizontalAlignment="Left"
                            Click="SyncNow_Click" Background="#1565C0" Foreground="White"/>
                    <TextBlock x:Name="SyncDetailText" TextWrapping="Wrap" Margin="0,8"/>
                    <TextBlock x:Name="DeviceText" Foreground="#777" TextWrapping="Wrap" Margin="0,8"/>
                    <Button Content="تسجيل الخروج من الجهاز" Padding="14,8" HorizontalAlignment="Left"
                            Click="SignOut_Click" Background="#B71C1C" Foreground="White"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="جاهز"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Left"><TextBlock x:Name="ClockText"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
