# Supabase Configuration
# Required: Your Supabase project URL and anonymous key
# Get these from: https://app.supabase.com → Project Settings → API

API_BASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Usage:
# flutter run --dart-define=API_BASE_URL=https://xxx.supabase.co --dart-define=SUPABASE_ANON_KEY=eyJ...
#
# Or create a .env file (not committed) and use:
# flutter run --dart-define-from-file=.env
