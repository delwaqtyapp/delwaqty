# =============================================================================
# Delwaqty Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
# Usage:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Or pass individually:
#   flutter run --dart-define=SUPABASE_DEV_URL=https://xxx.supabase.co --dart-define=SUPABASE_DEV_ANON_KEY=eyJ...
# =============================================================================

# Supabase Configuration (Required)
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_DEV_URL=https://your-dev-project.supabase.co
SUPABASE_DEV_ANON_KEY=your-dev-anon-key-here
SUPABASE_PROD_URL=https://your-prod-project.supabase.co
SUPABASE_PROD_ANON_KEY=your-prod-anon-key-here

# Google Maps Configuration (Required)
# Get API key from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps SDK for Android, Maps SDK for iOS, Directions API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Cloudflare Configuration (Optional)
# Used for: R2 asset storage + CDN delivery (does NOT replace Supabase)
# Get credentials from: https://dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_R2_BUCKET=delwaqty-assets
CLOUDFLARE_CDN_DOMAIN=cdn.delwaqty.com
