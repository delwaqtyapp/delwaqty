# =============================================================
# Delwaqty Platform - Environment Configuration
# =============================================================
# Copy this file to .env.dev, .env.staging, or .env.prod
# NEVER commit files with real credentials to version control.
# =============================================================

# --- Application ------------------------------------------------
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # true | false

# --- Supabase ---------------------------------------------------
# Get these from: https://app.supabase.com -> Project Settings -> API
SUPABASE_DEV_URL=https://your-dev-project.supabase.co
SUPABASE_DEV_ANON_KEY=your-dev-anon-key
SUPABASE_DEV_SERVICE_ROLE_KEY=your-dev-service-role-key  # Optional, for admin operations

SUPABASE_STAGING_URL=https://your-staging-project.supabase.co
SUPABASE_STAGING_ANON_KEY=your-staging-anon-key

SUPABASE_PROD_URL=https://your-prod-project.supabase.co
SUPABASE_PROD_ANON_KEY=your-prod-anon-key

# --- Google Maps ------------------------------------------------
# Get these from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable: Maps SDK, Directions API, Places API, Geocoding API, Distance Matrix API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_ANDROID_KEY=your-android-maps-key    # Optional, platform-specific
GOOGLE_MAPS_IOS_KEY=your-ios-maps-key            # Optional, platform-specific
GOOGLE_MAPS_WEB_KEY=your-web-maps-key            # Optional, platform-specific

# --- Firebase ---------------------------------------------------
# Get project ID from: https://console.firebase.google.com
# Download google-services.json (Android) and GoogleService-Info.plist (iOS)
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Cloudflare -------------------------------------------------
# Get these from: https://dash.cloudflare.com -> My Profile -> API Tokens
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_R2_BUCKET=delwaqty-assets
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id     # Usually same as CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_CDN_DOMAIN=cdn.delwaqty.com
CLOUDFLARE_ZONES_DOMAIN=delwaqty.com
CLOUDFLARE_IMAGES_ACCOUNT_ID=your-images-account-id
CLOUDFLARE_IMAGES_DELIVERY_URL=https://pub-xxx.images.cloudflare.com
