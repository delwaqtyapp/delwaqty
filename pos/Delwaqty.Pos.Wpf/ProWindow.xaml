<Window x:Class="Delwaqty.Pos.Wpf.ProWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مميزات PRO" Height="680" Width="880" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" FontSize="15">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="مميزات PRO: التأمين، التسعيرة الرسمية، النواقص" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1">
            <TabItem Header="شركات التأمين">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CompaniesGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الشركة" Width="2*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="تليفون" Width="*" Binding="{Binding Phone}"/>
                            <DataGridTextColumn Header="ملاحظات" Width="2*" Binding="{Binding Notes}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="CoNameBox" Width="180" Padding="6" ToolTip="اسم الشركة"/>
                        <TextBox x:Name="CoPhoneBox" Width="130" Padding="6" Margin="6,0" ToolTip="تليفون"/>
                        <Button Content="إضافة شركة" Padding="12,6" Click="AddCompany_Click" Background="#2E7D32" Foreground="White"/>
                        <Button Content="كشف حساب" Padding="12,6" Margin="6,0,0,0" Click="Statement_Click" Background="#1565C0" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="التسعيرة الرسمية والنواقص">
                <StackPanel Margin="8">
                    <Button Content="تطبيق التسعيرة الرسمية (وزارة الصحة) على الأصناف المطابقة"
                            Padding="14,8" HorizontalAlignment="Left" Click="ApplyMoh_Click"
                            Background="#1565C0" Foreground="White"/>
                    <Button Content="عرض النواقص (أصناف تحت حد الطلب)" Padding="14,8" Margin="0,8"
                            HorizontalAlignment="Left" Click="Shortage_Click" Background="#E65100" Foreground="White"/>
                    <DataGrid x:Name="ShortageGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="380">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Width="2*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="الرصيد" Width="*" Binding="{Binding Stock}"/>
                            <DataGridTextColumn Header="حد الطلب" Width="*" Binding="{Binding Level}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="يتطلب اتصالاً بالإنترنت"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
