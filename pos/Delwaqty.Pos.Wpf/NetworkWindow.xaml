<Window x:Class="Delwaqty.Pos.Wpf.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شبكة الصيدليات" Height="700" Width="900" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" FontSize="15">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="شبكة تبادل النواقص بين الصيدليات" FontSize="20" FontWeight="Bold"/>
            <Button Content="تحديث" DockPanel.Dock="Left" Padding="14,6" Click="Refresh_Click"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="الصيدليات المرتبطة:" FontWeight="Bold"/>
                <DataGrid x:Name="LinksGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6"
                          SelectionChanged="Link_Selected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصيدلية" Width="2*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="تليفون" Width="*" Binding="{Binding Phone}"/>
                        <DataGridTextColumn Header="الرصيد بيننا" Width="*" Binding="{Binding Balance}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="طلب صنف ناقص من الصيدلية المحددة" Padding="10,6" Margin="0,4"
                        Background="#1565C0" Foreground="White" Click="NewRequest_Click"/>
                <Button Content="مراسلة" Padding="10,6" Click="Message_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="طلبات التبادل:" FontWeight="Bold"/>
                <DataGrid x:Name="TransfersGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6"
                          SelectionChanged="Transfer_Selected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Width="2*" Binding="{Binding ItemName}"/>
                        <DataGridTextColumn Header="كمية" Width="*" Binding="{Binding Qty}"/>
                        <DataGridTextColumn Header="الحالة" Width="*" Binding="{Binding StatusAr}"/>
                        <DataGridTextColumn Header="قيمة نقدية" Width="*" Binding="{Binding CashValue}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel>
                    <Button Content="قبول" Padding="12,6" Margin="4" Click="Accept_Click" Background="#2E7D32" Foreground="White"/>
                    <Button Content="رفض" Padding="12,6" Margin="4" Click="Reject_Click" Background="#B71C1C" Foreground="White"/>
                    <Button Content="تم التسليم" Padding="12,6" Margin="4" Click="Handover_Click" Background="#00695C" Foreground="White"/>
                    <Button Content="تسوية بدل" Padding="12,6" Margin="4" Click="SettleSwap_Click" Background="#4527A0" Foreground="White"/>
                    <Button Content="تسوية نقدي" Padding="12,6" Margin="4" Click="SettleCash_Click" Background="#4527A0" Foreground="White"/>
                    <Button Content="تأكيد التسوية" Padding="12,6" Margin="4" Click="ConfirmSettle_Click" Background="#E65100" Foreground="White"/>
                    <Button Content="رفض التسوية" Padding="12,6" Margin="4" Click="RejectSettle_Click"/>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="المراسلات مع الصيدلية المحددة:" FontWeight="Bold"/>
            <ListBox x:Name="MessagesList" Margin="0,6"/>
            <DockPanel>
                <Button Content="إرسال" DockPanel.Dock="Left" Padding="14,6" Click="SendMessage_Click" Background="#1565C0" Foreground="White"/>
                <TextBox x:Name="MessageBox" Padding="8"/>
            </DockPanel>
        </StackPanel>

        <StatusBar Grid.Row="3">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="يتطلب اتصالاً بالإنترنت"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
