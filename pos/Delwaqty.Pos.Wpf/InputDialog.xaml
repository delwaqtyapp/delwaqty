<Window x:Class="Delwaqty.Pos.Wpf.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدخال" Height="230" Width="420" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontSize="16">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="ValueBox" FontSize="20" Padding="8" KeyDown="ValueBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="إلغاء" Padding="16,6" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button Content="تأكيد" Padding="16,6" Background="#2E7D32" Foreground="White" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
