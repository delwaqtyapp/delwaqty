<Window x:Class="Delwaqty.Pos.Wpf.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإيصال" Height="640" Width="440" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" FontSize="14">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#999" BorderThickness="1" Background="White" Padding="8">
            <ScrollViewer>
                <TextBlock x:Name="ReceiptText" FontFamily="Courier New" FontSize="14"
                           TextWrapping="Wrap" FlowDirection="RightToLeft"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="طباعة 🖨" Padding="16,8" Margin="6" FontSize="16"
                    Background="#1565C0" Foreground="White" Click="Print_Click"/>
            <Button Content="واتساب 📲" Padding="16,8" Margin="6" FontSize="16"
                    Background="#2E7D32" Foreground="White" Click="WhatsApp_Click"/>
            <Button Content="إغلاق" Padding="16,8" Margin="6" FontSize="16" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
